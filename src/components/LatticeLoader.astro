---
// Lattice Loader (React Bits), ported to static Astro markup so it renders on
// first paint with no JavaScript. Grid animation only — no label, timer or
// done/error states.

type Pattern = { cells: (number | null)[]; loop: number; scale?: number; lit?: number }

const PATTERNS: Record<string, Partial<Record<3 | 4, Pattern>>> = {
  arrow: { 3: { cells: [1, 2, 3, 0, 1, 2, 1, 2, 3], loop: 7.2, scale: 1 } },
  dots: { 3: { cells: [0, 1, 2, 0, 1, 2, 0, 1, 2], loop: 3, scale: 2.4 } },
  ripple: { 3: { cells: [2, 1, 2, 1, 0, 1, 2, 1, 2], loop: 4.8, scale: 1.5 } },
  spiral: { 3: { cells: [0, 1, 2, 7, 8, 3, 6, 5, 4], loop: 9, scale: 1.2, lit: 0.35 } },
  orbit: {
    3: { cells: [0, 1, 2, 7, null, 3, 6, 5, 4], loop: 8, scale: 1.2 },
    4: { cells: [0, 1, 2, 3, 11, null, null, 4, 10, null, null, 5, 9, 8, 7, 6], loop: 6, scale: 1.2, lit: 0.45 },
  },
  snake: {
    3: { cells: [0, 1, 2, 5, 4, 3, 6, 7, 8], loop: 9, scale: 1, lit: 0.35 },
    4: { cells: [0, 1, 2, 3, 7, 6, 5, 4, 8, 9, 10, 11, 15, 14, 13, 12], loop: 16, scale: 1, lit: 0.25 },
  },
  sweep: { 4: { cells: [0, 1, 2, 3, 1, 2, 3, 4, 2, 3, 4, 5, 3, 4, 5, 6], loop: 5, scale: 1, lit: 0.45 } },
  spin: { 4: { cells: [0, 0, 1, 1, 0, 0, 1, 1, 3, 3, 2, 2, 3, 3, 2, 2], loop: 4, scale: 1.6, lit: 0.35 } },
  rain: { 4: { cells: [0, 2, 1, 3, 1, 3, 2, 4, 2, 4, 3, 5, 3, 5, 4, 6], loop: 4, scale: 1.2, lit: 0.35 } },
  pulse: { 4: { cells: [2, 1, 1, 2, 1, 0, 0, 1, 1, 0, 0, 1, 2, 1, 1, 2], loop: 2.4, scale: 2.5, lit: 0.45 } },
}
const DEFAULT_PATTERN = { 3: "orbit", 4: "sweep" } as const

interface Props {
  pattern?: keyof typeof PATTERNS
  grid?: 3 | 4
  shape?: "round" | "square"
  color?: string
  cellSize?: number
  gap?: number
  step?: number
  idleOpacity?: number
  glow?: boolean
  glowColor?: string
  label?: string
}

const {
  pattern = "orbit",
  grid = 3,
  shape = "round",
  color = "currentColor",
  cellSize = 6,
  gap = 2,
  step = 90,
  idleOpacity = 0.15,
  glow = false,
  glowColor = "",
  label = "Loading",
} = Astro.props

const n = grid === 4 ? 4 : 3
const pat = PATTERNS[pattern]?.[n] ?? PATTERNS[DEFAULT_PATTERN[n]][n]!
const d = step * (pat.scale ?? 1)
const cycle = Math.round(pat.loop * d)
const lit = pat.lit && pat.lit !== 0.62 ? Math.round(pat.lit * 100) : undefined

const vars = [
  `--ll-n:${n}`,
  `--ll-cell:${cellSize}px`,
  `--ll-gap:${gap}px`,
  `--ll-color:${color}`,
  `--ll-idle:${idleOpacity}`,
  `--ll-glow:${glowColor || color}`,
  `--ll-cycle:${cycle}ms`,
].join(";")
---

<span role="status" aria-label={label} class="lattice-loader" data-shape={shape} data-glow={glow ? "" : undefined} style={vars}>
  <span class="lattice-loader__grid" aria-hidden="true">
    {
      pat.cells.map((unit) => (
        <span
          class="lattice-loader__cell"
          data-hole={unit == null ? "" : undefined}
          data-lit={lit}
          style={unit == null ? undefined : `animation-delay:${Math.round(unit * d)}ms`}
        />
      ))
    }
  </span>
</span>

<style is:inline>
  .lattice-loader {
    --ll-n: 3;
    --ll-cell: 6px;
    --ll-gap: 2px;
    --ll-color: currentColor;
    --ll-idle: 0.15;
    --ll-glow: currentColor;
    --ll-peak: 1;
    --ll-cycle: 864ms;
    --ll-ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    display: inline-flex;
  }

  .lattice-loader__grid {
    display: grid;
    grid-template-columns: repeat(var(--ll-n), var(--ll-cell));
    gap: var(--ll-gap);
  }

  .lattice-loader__cell {
    width: var(--ll-cell);
    height: var(--ll-cell);
    border-radius: max(1px, calc(var(--ll-cell) * 0.25));
    background: var(--ll-color);
    opacity: var(--ll-idle);
    animation: lattice-on var(--ll-cycle) var(--ll-ease-in-out) infinite;
  }

  .lattice-loader[data-shape="round"] .lattice-loader__cell {
    border-radius: 50%;
  }

  .lattice-loader[data-glow] .lattice-loader__cell:not([data-hole]) {
    box-shadow: 0 0 calc(var(--ll-cell) * 1.2) calc(var(--ll-cell) * 0.12) var(--ll-glow);
  }

  .lattice-loader__cell[data-lit="45"] { animation-name: lattice-on-45; }
  .lattice-loader__cell[data-lit="35"] { animation-name: lattice-on-35; }
  .lattice-loader__cell[data-lit="25"] { animation-name: lattice-on-25; }

  .lattice-loader__cell[data-hole] {
    animation: none;
    opacity: calc(var(--ll-idle) * 0.47);
  }

  @keyframes lattice-on {
    0%, 100% { opacity: var(--ll-idle); }
    18%, 42% { opacity: var(--ll-peak); }
    62% { opacity: var(--ll-idle); }
  }
  @keyframes lattice-on-45 {
    0%, 100% { opacity: var(--ll-idle); }
    13%, 31% { opacity: var(--ll-peak); }
    45% { opacity: var(--ll-idle); }
  }
  @keyframes lattice-on-35 {
    0%, 100% { opacity: var(--ll-idle); }
    10%, 24% { opacity: var(--ll-peak); }
    35% { opacity: var(--ll-idle); }
  }
  @keyframes lattice-on-25 {
    0%, 100% { opacity: var(--ll-idle); }
    7%, 17% { opacity: var(--ll-peak); }
    25% { opacity: var(--ll-idle); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lattice-loader { --ll-peak: 0.7; }
    .lattice-loader__cell {
      animation-delay: 0ms !important;
      animation-duration: 1400ms !important;
    }
  }
</style>
